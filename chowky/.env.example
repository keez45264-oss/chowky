FLASK_SECRET_KEY=replace-this-with-a-long-random-string
FLASK_ENV=development

# Local dev (SQLite) — leave DATABASE_URL empty to use SQLite at app/chowky.db
DATABASE_URL=

# Production (Render Postgres) — Render provides this automatically when you
# connect a managed Postgres add-on. Format:
# postgresql://user:password@host:port/dbname
